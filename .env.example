# Copiază acest fișier ca ".env.local" și completează valorile.
# Fișierul .env.local NU se urcă pe GitHub.

# Cheia de la https://resend.com (API Keys). Obligatorie pentru formular.
RESEND_API_KEY=

# Unde ajung cererile din formular. Dacă lipsește, se folosește emailul din site.config.ts.
CONTACT_TO=

# De la cine pleacă e-mailul. Trebuie să fie pe un domeniu verificat în Resend.
# Dacă lipsește, se folosește adresa de test onboarding@resend.dev
# (merge doar către adresa cu care ți-ai făcut contul Resend).
CONTACT_FROM=
